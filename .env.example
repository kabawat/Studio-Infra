# Backend Root Directory
BACKEND_ROOT=/var/www/be

# Optional: Override specific service
# AUTH_DIR=/var/www/be/studio-auth
# CORE_DIR=/var/www/be/studio-core
# PAYMENT_DIR=/var/www/be/studio-payment
# UTILITY_DIR=/var/www/be/studio-utility
# CONFIG_DIR=/var/www/be/config

# Redis hostname (default: redis)
REDIS_HOST=redis

# Redis container resources
REDIS_MAXMEMORY=256mb
REDIS_CONTAINER_MEMORY=768m
REDIS_CPUS=1.0
REDIS_NETWORK_NAME=redis-private
REDIS_VOLUME_NAME=redis-data